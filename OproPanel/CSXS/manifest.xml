<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="5.0" ExtensionBundleId="com.s.OProPanel" ExtensionBundleVersion="11.2" ExtensionBundleName="Otto Joke : CCB"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
   <ExtensionList>
      <Extension Id="com.s.OProPanel" Version="0.0.5" />
      <Extension Id="com.s.OProPanel.sssa" Version="0.0.5" />
      <Extension Id="com.s.OProPanel.compat.sssa" Version="0.0.5" />
   </ExtensionList>
   <ExecutionEnvironment>
      <HostList>
         <Host Name="PPRO" Version="9.0" />
      </HostList>
      <LocaleList>
         <Locale Code="All" />
      </LocaleList>
      <RequiredRuntimeList>
         <RequiredRuntime Name="CSXS" Version="6.0" />
      </RequiredRuntimeList>
   </ExecutionEnvironment>

   <DispatchInfoList>
      <Extension Id="com.s.OProPanel">
         <DispatchInfo >
            <Resources>
               <MainPath>./index.html</MainPath>
               <ScriptPath>./PProPanel.jsx</ScriptPath>
               <CEFCommandLine>
                  <Parameter>--enable-nodejs</Parameter>
                  <Parameter>--mixed-context</Parameter>
                  <Parameter>--allow-file-access</Parameter>
                  <Parameter>--allow-file-access-from-files</Parameter>
                  <Parameter>--allow-running-insecure-content</Parameter>
                  <Parameter>--disable-web-security</Parameter>
                  <Parameter>--use-fake-ui-for-media-stream</Parameter>
               </CEFCommandLine>
            </Resources>
            <Lifecycle>
               <AutoVisible>true</AutoVisible>
               <!-- <StartOn> -->
               <!-- Premiere Pro dispatches this event whenever it gains focus from the OS -->
               <!-- <Event>com.adobe.csxs.events.ApplicationActivate</Event> -->
               <!-- </StartOn> -->
            </Lifecycle>
            <UI>
               <Type>Panel</Type>
               <Menu>顺飞面板</Menu>
               <Geometry>
                  <Size>
                     <Height>300</Height>
                     <Width>420</Width>
                  </Size>
               </Geometry>
            </UI>
         </DispatchInfo>
      </Extension>
      <Extension Id="com.s.OProPanel.compat.sssa">
         <DispatchInfo>
            <Resources>
               <MainPath>./compat_sssa.html</MainPath>
               <ScriptPath>./PProPanel.jsx</ScriptPath>
               <CEFCommandLine>
                  <Parameter>--enable-nodejs</Parameter>
                  <Parameter>--mixed-context</Parameter>
                  <Parameter>--allow-file-access</Parameter>
                  <Parameter>--allow-file-access-from-files</Parameter>
                  <Parameter>--allow-running-insecure-content</Parameter>
                  <Parameter>--disable-web-security</Parameter>
                  <Parameter>--use-fake-ui-for-media-stream</Parameter>
               </CEFCommandLine>
            </Resources>
            <Lifecycle>
               <AutoVisible>true</AutoVisible>
            </Lifecycle>
            <UI>
               <Type>Panel</Type>
               <Menu>顺飞面板 - 干飞马</Menu>
               <Geometry>
                  <Size>
                     <Height>760</Height>
                     <Width>1180</Width>
                  </Size>
               </Geometry>
            </UI>
         </DispatchInfo>
      </Extension>
      <Extension Id="com.s.OProPanel.sssa">
         <DispatchInfo>
            <Resources>
               <MainPath>./sssa.html</MainPath>
               <ScriptPath>./PProPanel.jsx</ScriptPath>
               <CEFCommandLine>
                  <Parameter>--enable-nodejs</Parameter>
                  <Parameter>--mixed-context</Parameter>
                  <Parameter>--allow-file-access</Parameter>
                  <Parameter>--allow-file-access-from-files</Parameter>
                  <Parameter>--allow-running-insecure-content</Parameter>
                  <Parameter>--disable-web-security</Parameter>
                  <Parameter>--use-fake-ui-for-media-stream</Parameter>
               </CEFCommandLine>
            </Resources>
            <Lifecycle>
               <AutoVisible>true</AutoVisible>
            </Lifecycle>
            <UI>
               <Type>Panel</Type>
               <Menu>顺飞面板 - 飞八分钱</Menu>
               <Geometry>
                  <Size>
                     <Height>760</Height>
                     <Width>1180</Width>
                  </Size>
               </Geometry>
            </UI>
         </DispatchInfo>
      </Extension>
   </DispatchInfoList>
</ExtensionManifest>
